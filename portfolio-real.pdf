      background:linear-gradient(145deg,#e8f1eb,#fff);
      border:8px solid #fff;
      box-shadow:0 18px 42px rgba(23,63,43,.13);
    }
    .hero-mini{
      text-align:center;
      color:var(--muted);
      font-size:.94rem;
    }
    .hero-mini strong{color:var(--green)}

    /* SECTION */
    section{
      padding:88px 0;
      scroll-margin-top:80px;
    }
    .section-soft{
      background:#fff;
    }
    .section-head{
      max-width:760px;
      margin:0 auto 38px;
      text-align:center;
    }
    .section-kicker{
      color:var(--green3);
      font-size:.86rem;
      font-weight:700;
      letter-spacing:.12em;
      text-transform:uppercase;
    }
    .section-head h2{
      margin:6px 0 10px;
      color:var(--green);
      font-size:clamp(1.8rem,4vw,2.65rem);
      line-height:1.2;
    }
    .section-head p{
      margin:0;
      color:var(--muted);
    }

    /* CARDS / GRIDS */
    .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}

    .card{
      background:#fff;
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:25px;
      box-shadow:0 8px 25px rgba(23,63,43,.05);
      transition:.28s;
    }
    .card:hover{
      transform:translateY(-4px);
      box-shadow:var(--shadow);
    }
    .card h3,.card h4{
      margin:0 0 8px;
      color:var(--green);
    }
    .card p{
      margin:0;
      color:var(--muted);
    }

    .profile-list{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:11px 22px;
      margin-top:14px;
    }
    .profile-row{
      padding:10px 0;
      border-bottom:1px dashed var(--border);
    }
    .profile-row span:first-child{
      color:#718078;
      display:block;
      font-size:.84rem;
    }
    .profile-row strong{
      color:var(--text);
    }

    /* SOP */
    .sop{
      font-size:1.01rem;
      color:#48564f;
    }
    .sop p{
      margin:0 0 15px;
    }
    .quote-box{
      margin-top:20px;
      padding:18px 20px;
      border-left:4px solid var(--green3);
      background:var(--light);
      border-radius:0 16px 16px 0;
      color:var(--green);
      font-weight:600;
    }

    /* EDUCATION */
    .stat{
      padding:22px;
      border-radius:20px;
      background:linear-gradient(150deg,#fff,var(--light));
      border:1px solid var(--border);
    }
    .stat .num{
      font-size:2rem;
      line-height:1;
      color:var(--green);
      font-weight:700;
    }
    .stat .label{
      color:var(--muted);
      margin-top:8px;
      font-size:.9rem;
    }
    .table-wrap{
      overflow:auto;
      margin-top:26px;
      border:1px solid var(--border);
      border-radius:20px;
      background:#fff;
      box-shadow:0 8px 25px rgba(23,63,43,.04);
    }
    table{
      width:100%;
      border-collapse:collapse;
      min-width:640px;
    }
    th,td{
      padding:13px 15px;
      border-bottom:1px solid var(--border);
      text-align:left;
    }
    th{
      background:var(--light);
      color:var(--green);
      font-weight:700;
    }
    tr:last-child td{border-bottom:0}

    /* SKILLS */
    .skill{
      display:flex;
      justify-content:space-between;
      gap:10px;
      margin-bottom:10px;
      font-size:.92rem;
    }
    .skill-bar{
      height:8px;
      background:#e6eee9;
      border-radius:999px;
      overflow:hidden;
      margin-bottom:17px;
    }
    .skill-fill{
      height:100%;
      background:linear-gradient(90deg,var(--green),var(--green3));
      border-radius:inherit;
    }
    .tag-wrap{display:flex;flex-wrap:wrap;gap:8px}
    .tag{
      padding:7px 11px;
      background:var(--light);
      color:var(--green);
      border:1px solid var(--border);
      border-radius:999px;
      font-size:.86rem;
    }

    /* PROJECTS */
    .project-icon{
      width:48px;height:48px;
      border-radius:15px;
      display:grid;
      place-items:center;
      background:var(--light);
      font-size:23px;
      margin-bottom:15px;
    }
    .project-card ul{
      margin:14px 0 0;
      padding-left:20px;
      color:var(--muted);
    }

    /* TIMELINE */
    .timeline{
      position:relative;
      max-width:980px;
      margin:0 auto;
    }
    .timeline:before{
      content:"";
      position:absolute;
      left:16px;
      top:6px;
      bottom:6px;
      width:2px;
      background:#d6e3dc;
    }
    .timeline-item{
      position:relative;
      padding-left:54px;
      margin-bottom:25px;
    }
    .timeline-dot{
      position:absolute;
      left:7px;
      top:7px;
      width:20px;height:20px;
      border-radius:50%;
      background:var(--green);
      border:5px solid #fff;
      box-shadow:0 0 0 1px #cdded4;
    }
    .timeline-card{
      background:#fff;
      border:1px solid var(--border);
      border-radius:20px;
      padding:21px 23px;
      box-shadow:0 7px 22px rgba(23,63,43,.04);
    }
    .timeline-meta{
      color:var(--green3);
      font-size:.82rem;
      font-weight:700;
      margin-bottom:4px;
    }
    .timeline-card h3{
      margin:0 0 8px;
      color:var(--green);
    }
    .timeline-card p{
      color:var(--muted);
      margin:0;
    }

    /* VOLUNTEER */
    .volunteer-number{
      font-size:1.8rem;
      font-weight:700;
      color:var(--green);
      margin-bottom:4px;
    }

    /* PORTFOLIO LINK */
    .portfolio-hero{
      padding:34px;
      border-radius:30px;
      background:
        radial-gradient(circle at 90% 10%,rgba(255,255,255,.18),transparent 25%),
        linear-gradient(135deg,var(--green),var(--green2));
      color:#fff;
      box-shadow:0 16px 40px rgba(23,63,43,.18);
    }
    .portfolio-hero h3{
      margin:0 0 8px;
      font-size:1.8rem;
    }
    .portfolio-hero p{
      margin:0;
      color:rgba(255,255,255,.84);
    }
    .portfolio-actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:18px;
    }
    .btn-white{
      background:#fff;
      color:var(--green);
      border-color:#fff;
    }
    .btn-outline-white{
      background:transparent;
      color:#fff;
      border-color:rgba(255,255,255,.6);
    }
    .pdf-frame{
      margin-top:25px;
      border:1px solid var(--border);
      border-radius:22px;
      overflow:hidden;
      background:#fff;
      box-shadow:var(--shadow);
    }
    .pdf-frame iframe{
      display:block;
      width:100%;
      height:760px;
      border:0;
    }

    /* CONTACT */
    .contact-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:20px;
    }
    .contact-item{
      display:flex;
      gap:14px;
      align-items:flex-start;
      padding:16px 0;
      border-bottom:1px dashed var(--border);
    }
    .contact-item:last-child{border-bottom:0}
    .contact-icon{
      width:40px;height:40px;
      border-radius:12px;
      display:grid;
      place-items:center;
      background:var(--light);
      flex:none;
    }
    .contact-item small{
      display:block;
      color:#78867f;
    }
    .contact-item strong{
      color:var(--text);
      word-break:break-word;
    }

    /* FOOTER */
    footer{
      padding:28px 0 40px;
      background:#132d20;
      color:rgba(255,255,255,.78);
      text-align:center;
    }
    footer strong{color:#fff}
    .footer-quote{
      font-size:1.05rem;
      color:#fff;
      font-weight:500;
      margin-bottom:4px;
    }

    /* REVEAL */
    .reveal{
      opacity:0;
      transform:translateY(24px);
      transition:opacity .65s ease, transform .65s ease;
    }
    .reveal.show{
      opacity:1;
      transform:none;
    }

    /* TOP BUTTON */
    #topBtn{
      position:fixed;
      right:20px;
      bottom:20px;
      width:46px;height:46px;
      border:0;
      border-radius:15px;
      background:var(--green);
      color:#fff;
      display:grid;
      place-items:center;
      font-size:1.1rem;
      cursor:pointer;
      opacity:0;
      pointer-events:none;
      transform:translateY(10px);
      transition:.25s;
      box-shadow:0 10px 24px rgba(23,63,43,.2);
      z-index:999;
    }
    #topBtn.show{
      opacity:1;
      pointer-events:auto;
      transform:none;
    }

    @media (max-width:900px){
      .hero-grid,
      .grid-3,
      .grid-4,
      .contact-grid,
      .grid-2{grid-template-columns:1fr}
      .hero{text-align:center}
      .hero p{margin-left:auto;margin-right:auto}
      .hero-actions{justify-content:center}
      .nav-inner{align-items:flex-start;padding:12px 0}
      .nav-links{max-height:92px;overflow:auto}
      .profile-list{grid-template-columns:1fr}
    }

    @media (max-width:600px){
      section{padding:68px 0}
      .nav-inner{display:block}
      .brand{margin-bottom:8px}
      .nav-links{justify-content:flex-start}
      .nav-links a{font-size:.81rem;padding:6px 8px}
      .hero{padding:62px 0}
      .hero-card{padding:22px}
      .avatar{width:145px;height:145px;font-size:64px}
      .card{padding:21px}
      .pdf-frame iframe{height:560px}
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <nav class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#home">
