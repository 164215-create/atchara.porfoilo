from pathlib import Path
import shutil

out = Path("/mnt/data/portfolio_atchara_full.html")
pdf_src = Path("/mnt/data/Elegant Minimalist A4 Stationery Paper Document_20260906_172458_0000.pdf")
pdf_dst = Path("/mnt/data/portfolio_atchara.pdf")

if pdf_src.exists():
    shutil.copy2(pdf_src, pdf_dst)

html = r'''<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#173f2b" />
  <meta name="description" content="Portfolio ของนางสาวอัจฉรา ทับทิมหิน ว่าที่นักศึกษาวิศวกรรมโยธา" />
  <title>Atchara Thabthimhin | Civil Engineering Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --green:#173f2b;
      --green2:#235c40;
      --green3:#3e7a5a;
      --light:#eef5f0;
      --lighter:#f7faf8;
      --text:#24332b;
      --muted:#66756d;
      --white:#ffffff;
      --border:#dfe9e3;
      --shadow:0 14px 40px rgba(23,63,43,.10);
      --radius:24px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
