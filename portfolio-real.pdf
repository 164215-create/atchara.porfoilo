      background:rgba(255,255,255,.92);
      backdrop-filter:blur(14px);
      border-bottom:1px solid rgba(223,233,227,.9);
    }
    .nav-inner{
      min-height:72px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      font-weight:700;
      color:var(--green);
      letter-spacing:.03em;
    }
    .brand-mark{
      width:40px;height:40px;
      border-radius:14px;
      display:grid;
      place-items:center;
      color:#fff;
      background:linear-gradient(135deg,var(--green),var(--green3));
      box-shadow:0 8px 20px rgba(23,63,43,.18);
    }
    .nav-links{
      display:flex;
      align-items:center;
      flex-wrap:wrap;
      justify-content:flex-end;
      gap:7px;
    }
    .nav-links a{
      padding:8px 11px;
      border-radius:10px;
      font-size:.9rem;
      color:#53635a;
      transition:.25s;
    }
    .nav-links a:hover{
      color:var(--green);
      background:var(--light);
    }

    /* HERO */
    .hero{
      position:relative;
      overflow:hidden;
      padding:86px 0 78px;
      background:
        radial-gradient(circle at 10% 15%,rgba(62,122,90,.10),transparent 28%),
        radial-gradient(circle at 88% 20%,rgba(35,92,64,.10),transparent 25%),
        linear-gradient(180deg,#fff,var(--lighter));
    }
    .hero-grid{
      display:grid;
      grid-template-columns:1.3fr .7fr;
      gap:42px;
      align-items:center;
    }
    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:var(--light);
      color:var(--green);
      border:1px solid var(--border);
      border-radius:999px;
      padding:7px 13px;
      font-size:.88rem;
      font-weight:600;
    }
    .hero h1{
      margin:18px 0 7px;
      color:var(--green);
      font-size:clamp(2.35rem,6vw,5.2rem);
      line-height:1.05;
      letter-spacing:.025em;
    }
    .hero h2{
      margin:0;
      font-size:clamp(1.2rem,2vw,1.65rem);
      font-weight:500;
    }
    .hero p{
      max-width:780px;
      color:var(--muted);
      margin:18px 0 0;
      font-size:1.03rem;
    }
    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:25px;
    }
    .btn{
      display:inline-flex;
