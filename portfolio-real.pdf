      background:var(--green);
      border-color:var(--green);
      box-shadow:0 10px 24px rgba(23,63,43,.16);
    }
    .btn-primary:hover{
      transform:translateY(-2px);
      background:var(--green2);
    }
    .btn-secondary{
      color:var(--green);
      background:#fff;
    }
    .btn-secondary:hover{
      transform:translateY(-2px);
      background:var(--light);
    }
    .hero-card{
      background:#fff;
      border:1px solid var(--border);
      box-shadow:var(--shadow);
      border-radius:32px;
      padding:28px;
    }
    .avatar{
